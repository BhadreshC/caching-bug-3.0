{% doc %}
  Renders a single media grid item: an image or video with an optional
  heading, wrapped in a link when one is provided. The media zooms in
  slightly on hover.

  @example
  {% content_for 'block', type: 'media-grid-item', id: 'media-grid-item' %}
{% enddoc %}

{% liquid
  assign item_media = block.settings.image
  if block.settings.media_type == 'video'
    assign item_media = block.settings.video
  endif

  if block.settings.link != blank
    assign wrapper_tag = 'a'
  else
    assign wrapper_tag = 'div'
  endif
%}

<{{ wrapper_tag }}
  class="media-grid-item"
  {% if wrapper_tag == 'a' %}
    href="{{ block.settings.link }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  <div class="media-grid-item__media">
    {%- if item_media != blank -%}
      {% render 'media', media: item_media, class: 'media-grid-item__asset' %}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'media-grid-item__placeholder' }}
    {%- endif -%}
  </div>

  {%- if block.settings.heading != blank -%}
    <h3 class="media-grid-item__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}
</{{ wrapper_tag }}>

{% stylesheet %}
  .media-grid-item {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .media-grid-item__media {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .media-grid-item__media .media-grid-item__asset,
  .media-grid-item__media .media-grid-item__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .media-grid-item:hover .media-grid-item__media .media-grid-item__asset,
  .media-grid-item:hover .media-grid-item__media .media-grid-item__placeholder {
    transform: scale(1.06);
  }

  .media-grid-item__heading {
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .media-grid-item__media .media-grid-item__asset,
    .media-grid-item__media .media-grid-item__placeholder {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.media_grid_item",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "t:labels.media_type",
      "default": "image",
      "options": [
        { "value": "image", "label": "t:options.media_type.image" },
        { "value": "video", "label": "t:options.media_type.video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:general.media_grid_item"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [{ "name": "t:general.media_grid_item" }]
}
{% endschema %}
