[
  {
    "name": "theme_info",
    "theme_name": "NSL Skeleton",
    "theme_version": "1.0.0",
    "theme_author": "Not Selling Liquid",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:settings_schema.product-grid.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_vendor",
        "label": "Show vendor"
      },
      {
        "type": "checkbox",
        "id": "enable_compare",
        "label": "Show compare at price"
      },
      {
        "type": "checkbox",
        "id": "enable_image_hover",
        "label": "t:settings_schema.product-grid.settings.enable_image_hover.label",
        "default": true
      },
      {
        "type": "select",
        "id": "product_image_height",
        "label": "t:settings_schema.product-grid.settings.grid_ratio.label",
        "options": [
          {
            "label": "t:settings_schema.product-grid.settings.grid_ratio.option__1.label",
            "value": "square"
          },
          {
            "label": "t:settings_schema.product-grid.settings.grid_ratio.option__2.label",
            "value": "portrait"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_size_Selector",
        "label": "t:settings_schema.product-grid.settings.show_size_selector.label",
        "default": true
      },
      {
        "type": "select",
        "id": "size_selector",
        "label": "t:settings_schema.product-grid.settings.size_selector.label",
        "options": [
          {
            "label": "t:settings_schema.product-grid.settings.size_selector.option__1.label",
            "value": "go_to_detail"
          },
          {
            "label": "t:settings_schema.product-grid.settings.size_selector.option__2.label",
            "value": "go_to_cart"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_quickbuy_mobile",
        "label": "t:settings_schema.product-grid.settings.show_quidckbuy.label",
        "default": true
      }
    ]
  },
