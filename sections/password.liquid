{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}
{{ 'password.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-id-{{ section.id }}{ {% if section.settings.text-color != blank %}color:{{ section.settings.text-color }}{% endif %};}
{%- endstyle -%}
<section class="section-password section-id-{{ section.id }}">
  {%- if section.settings.image != blank or section.settings.video != blank -%}
  <div class="password-media">
    {%- if section.settings.media_type == 'video' -%}
      {%- if section.settings.mb_media_type == 'video' -%}
        {%- render 'media', media: section.settings.video, mobile_media: section.settings.mb_video, autoplay: true, loop: true, muted: true -%}
      {%- else -%}
        {%- render 'media', media: section.settings.video, mobile_media: section.settings.mb_image, autoplay: true, loop: true, muted: true -%}
      {%- endif -%}
    {%- else -%}
      {%- if section.settings.mb_media_type == 'video' -%}
        {%- render 'media', media: section.settings.image, mobile_media: section.settings.mb_video -%}
      {%- else -%}
        {%- render 'media', media: section.settings.image, mobile_media: section.settings.mb_image -%}
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- endif -%}
  <div class="password-meta">
    <div class="password-logo">
      {%- render 'logo', section: section -%}
    </div>
    <h1>{{ 'password.title' | t }}</h1>
    {% if shop.password_message != blank %}
      <p>{{ shop.password_message }}</p>
    {% endif %}
    {% form 'storefront_password' %}
      {% if form.errors %}
        {{ form.errors | default_errors }}
      {% endif %}
      <label for="password-input">
        {{ 'password.password' | t }}
      </label>
      <input type="password" name="password" id="password-input">
      <button type="submit" aria-label="Password">
        {{ 'password.enter' | t }}
      </button>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type":"select",
      "id":"logo_type",
      "label":"Logo Type",
      "options":[
        {
          "label":"Image",
          "value":"image"
        },
        {
          "label":"SVG",
          "value":"svg"
        }
      ]
    },
    {
      "type":"image_picker",
      "id":"logo",
      "label": "Logo",
      "visible_if": "{{ section.settings.logo_type == 'image' }}"
    },
    {
      "type":"html",
      "id":"svg_logo",
      "label": "SVG Logo",
      "visible_if": "{{ section.settings.logo_type == 'svg' }}"
    },
    {
      "type": "color",
      "id":"text-color",
      "label": "Text Color",
      "default":"#000000"
    },
    {
      "type":"header",
      "content":"Desktop"
    },
    {
      "type":"select",
      "id":"media_type",
      "label":"Media Type",
      "options":[
        {
          "label":"Image",
          "value":"image"
        },
        {
          "label":"Video",
          "value":"video"
        }
      ]
    },
    {
      "type":"image_picker",
      "id":"image",
      "label":"Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video mp4",
      "info": "Replaces external video if both are set."
    },
    {
      "type":"header",
      "content":"Mobile"
    },
    {
      "type":"select",
      "id":"mb_media_type",
      "label":"Media Type",
      "options":[
        {
          "label":"Image",
          "value":"image"
        },
        {
          "label":"Video",
          "value":"video"
        }
      ]
    },
    {
      "type":"image_picker",
      "id":"mb_image",
      "label":"Image"
    },
    {
      "type": "video",
      "id": "mb_video",
      "label": "Video mp4",
      "info": "Replaces external video if both are set."
    }
  ]
}
{% endschema %}
