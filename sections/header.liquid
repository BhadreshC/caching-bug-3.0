{{ 'header.css' | asset_url | stylesheet_tag }}

{%- assign handles = section.settings.page_handle | newline_to_br | split: '<br />' -%}
{%- assign transparent = false -%}
{%- for handle in handles -%}
  {%- assign page_handle = handle | handle -%}
  {%- assign temp = template | handle -%}
  {%- if page_handle == temp or page_handle == page.handle -%}
    {%- assign transparent = true -%}
  {%- endif -%}
{%- endfor -%}
<header class="{% if section.settings.enable_sticky %}header-sticky{% endif %}{% if transparent %} header-transparent{% endif %}">
  <div class="header-title">
    <div class="d-lg-none">
      <a href="#" class="menu-burdger">
        <span></span><span></span><span></span>
      </a>	
    </div>
    <div class="header-logo">
      {%- render 'logo', section: section -%}
    </div>
  </div>
  <div class="header__menu d-none d-lg-block">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {%- if section.settings.enable_search -%}
      <li class="searchlist">
        <div class="d-none d-lg-block">
          {%- render 'search-bar', section:section -%}
        </div>
        <div class="d-block d-lg-none">
          <button class="mobile-search">{{ 'search.svg' | inline_asset_content }}</button>
        </div>
      </li>
    {%- endif -%}
    {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.menu }}">
        {% if customer %}
          <div class="account-button__fallback"></div>
        {% else %}
          <span
            slot="signed-out-avatar"
          >
            account
          </span>

          <span
            slot="signed-out-avatar"
            aria-hidden="true"
          >
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
        {% endif %}
      </shopify-account>
      {% comment %} {{ 'icon-account.svg' | inline_asset_content | link_to: routes.account_url }} {% endcomment %}
    {% endif %}

    {%- if template contains 'cart' -%}
      <a href="{{ routes.cart_url }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}
        </a>
      {%- else -%}
      <button class="header-cart">
        {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <sup class="cart-count">{{ cart.item_count }}</sup>
          {% endif %}
        </button>
    {%- endif -%}
    {% comment %} <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a> {% endcomment %}
  </div>

  <div class="mobile-serachbox">
    {%- render 'search-bar', section:section -%}
  </div>
  {%- if section.settings.enable_search -%}
  <div id="predictive-search" tabindex="-1"></div>
  <div class="search-suggetion">
    {% if settings.search_recommended_title != blank %}
    <h3>{{ settings.search_recommended_title }}</h3>
    {% endif %}
    <div class="search-row">
      {%- for product in settings.s_pdt_list -%}
        <div class="search-column">
          <div class="collection-product">
            {% if product.featured_image %}
              {% render 'image',
                class: 'collection-product__image',
                image: product.featured_image,
                url: product.url,
                width: 400,
                height: 400,
                crop: 'center'
              %}
            {% endif %}
            <div class="collection-product__content">
              <h3 class="collection-product__title">
                {{ product.title | escape | link_to: product.url }}
              </h3>
              <div class="collection-product__price">{{ product.price | money }}</div>
            </div>
          </div>      
        </div>
      {%- endfor -%}    
    </div>
  </div>
  {%- endif -%}
</header>
{%- render 'menu-drawer' -%}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:general.header",
  "class": "main-header",
  "settings": [
    {
      "type":"select",
      "id":"logo_type",
      "label":"Logo Type",
      "options":[
        {
          "label":"Image",
          "value":"image"
        },
        {
          "label":"SVG",
          "value":"svg"
        }
      ]
    },
    {
      "type":"image_picker",
      "id":"logo",
      "label": "Logo"
    },
    {
      "type":"html",
      "id":"svg_logo",
      "label": "SVG Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type":"checkbox",
      "id":"enable_search",
      "label":"t:sections.header.settings.enable_search.label",
      "default":true
	  },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky"
    },
    {
      "type":"html",
      "id":"cart_icon",
      "label":"Cart Icon"
    },
    {
      "type":"textarea",
      "id":"page_handle",
      "label":"List",
      "info":"Add page-handle or page handle which have transparent header"
    }
  ]
}
{% endschema %}
