{%- if section.settings.show_layout == false -%}
    {%  layout none %}
{%- endif -%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'vendor/qrcode.js' | shopify_asset_url | script_tag }}
    {% render 'meta-tags' %}
    {{ content_for_header }}

    {% style %}
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-primary--family);
        font-weight: var(--font-primary--weight);
        font-style: var(--font-primary--style);
        line-height: var(--line-height-base);
        -webkit-font-smoothing: antialiased;
      }

      .gift-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: var(--spacing-lg);
        background-color: var(--gift-card-bg);
        color: var(--color-foreground);
        text-align: center;
      }

      .gift-card__logo {
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__logo img,
      .gift-card__logo svg {
        max-width: 160px;
        height: auto;
      }

      .gift-card__logo span {
        font-size: 1.5rem;
        font-weight: 700;
      }

      .gift-card__image {
        width: 100%;
        max-width: 400px;
        margin-bottom: var(--spacing-lg);
        border-radius: var(--style-border-radius-md);
        overflow: hidden;
      }

      .gift-card__image img {
        display: block;
        width: 100%;
        height: auto;
      }

      .gift-card__balance {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: var(--line-height-tight);
        margin-bottom: var(--spacing-xs);
      }

      .gift-card__status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: var(--style-border-radius-sm);
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: var(--spacing-sm);
      }

      .gift-card__status--expired {
        background-color: #fee2e2;
        color: #991b1b;
      }

      .gift-card__status--active {
        background-color: #dcfce7;
        color: #166534;
      }

      .gift-card__expiry {
        font-size: 0.875rem;
        opacity: 0.7;
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__shop-name {
        font-size: 1.125rem;
        margin-bottom: var(--spacing-xs);
      }

      .gift-card__message {
        font-size: 0.875rem;
        opacity: 0.7;
        margin-bottom: var(--spacing-md);
      }

      .gift-card__code-wrapper {
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__code {
        display: inline-block;
        padding: 0.75rem 1.25rem;
        background: rgba(0, 0, 0, 0.05);
        border-radius: var(--style-border-radius-sm);
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        font-family: monospace;
        word-break: break-all;
      }

      .gift-card__qr {
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__qr img {
        display: block;
        margin: 0 auto;
      }

      .gift-card__actions {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: var(--style-border-radius-inputs);
        font-size: 0.875rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: opacity var(--transition-base);
        text-decoration: none;
      }

      .gift-card__btn:hover {
        opacity: 0.85;
      }

      .gift-card__btn--primary {
        background-color: var(--color-button-bg);
        color: var(--color-button-text);
      }

      .gift-card__btn--secondary {
        background-color: transparent;
        border: 1px solid var(--color-border);
        color: var(--color-foreground);
      }

      .gift-card__btn svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      .gift-card__apple-wallet {
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__apple-wallet img {
        width: 160px;
        height: auto;
      }

      .gift-card__copy-success {
        display: none;
        font-size: 0.8125rem;
        color: #166534;
        margin-top: var(--spacing-xs);
      }

      .gift-card__copy-success--visible {
        display: block;
      }

      @media print {
        .gift-card__actions,
        .gift-card__apple-wallet {
          display: none;
        }
      }
    {% endstyle %}
  </head>

  <body>
    {%- if section.settings.show_header -%}
      {% section 'header' %}
    {%- endif -%}

    <main
      class="gift-card"
      style="--gift-card-bg: {{ section.settings.background_color }};"
    >
      {%- comment -%} Logo {%- endcomment -%}
      {%- if section.settings.show_logo -%}
        <div class="gift-card__logo">
          {%- if section.settings.custom_logo != blank -%}
            {{ section.settings.custom_logo | image_url: width: 320 | image_tag: alt: shop.name, loading: 'eager' }}
          {%- else -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Gift card image {%- endcomment -%}
      <div class="gift-card__image">
        {%- if section.settings.custom_image != blank -%}
          {{ section.settings.custom_image | image_url: width: 800 | image_tag: loading: 'eager' }}
        {%- else -%}
          <img
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="400"
            height="260"
            loading="eager"
          >
        {%- endif -%}
      </div>

      {%- comment -%} Balance {%- endcomment -%}
      <p class="gift-card__balance">{{ gift_card.balance | money }}</p>

      {%- comment -%} Status {%- endcomment -%}
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <span class="gift-card__status gift-card__status--expired">
          {{ 'gift_card.expired' | t }}
        </span>
      {%- else -%}
        <span class="gift-card__status gift-card__status--active">
          {{ 'gift_card.active' | t }}
        </span>
      {%- endif -%}

      {%- comment -%} Expiry {%- endcomment -%}
      {%- if gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p class="gift-card__expiry">
          {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
        </p>
      {%- endif -%}

      <p class="gift-card__shop-name">{{ shop.name }}</p>
      <p class="gift-card__message">{{ 'gift_card.use_at_checkout' | t }}</p>

      {%- comment -%} Code {%- endcomment -%}
      <div class="gift-card__code-wrapper">
        <span class="gift-card__code" id="gift-card-code">
          {{ gift_card.code | format_code }}
        </span>
        <p class="gift-card__copy-success" id="copy-success">
          {{ 'gift_card.copied' | t }}
        </p>
      </div>

      {%- comment -%} QR code {%- endcomment -%}
      {%- if section.settings.show_qr_code -%}
        <div class="gift-card__qr">
              <qr-code class="gift-card__qr-code" identifier="{{ gift_card.qr_identifier }}"></qr-code>
        </div>
      {%- endif -%}

      {%- comment -%} Actions {%- endcomment -%}
      <div class="gift-card__actions">
        <button type="button" class="gift-card__btn gift-card__btn--primary" id="copy-btn" aria-label="{{ 'gift_card.copy_code' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          {{ 'gift_card.copy_code' | t }}
        </button>

        <button type="button" class="gift-card__btn gift-card__btn--secondary" onclick="window.print()" aria-label="{{ 'gift_card.print' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          {{ 'gift_card.print' | t }}
        </button>
      </div>

      {%- comment -%} Apple Wallet {%- endcomment -%}
      {%- if gift_card.pass_url -%}
        <div class="gift-card__apple-wallet">
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="160"
              height="48"
            >
          </a>
        </div>
      {%- endif -%}
    </main>
    <script>
      document.getElementById('copy-btn').addEventListener('click', function () {
        var codeEl = document.getElementById('gift-card-code');
        var code = codeEl.innerText.replace(/\\s/g, '');
        navigator.clipboard.writeText(code).then(function () {
          var msg = document.getElementById('copy-success');
          msg.classList.add('gift-card__copy-success--visible');
          setTimeout(function () {
            msg.classList.remove('gift-card__copy-success--visible');
          }, 2000);
        });
      });

      var QrCode = class extends HTMLElement {
  connectedCallback() {
    new window.QRCode(this, {
      text: this.getAttribute("identifier"),
      width: this.hasAttribute("width") ? parseInt(this.getAttribute("width")) : 100,
      height: this.hasAttribute("height") ? parseInt(this.getAttribute("height")) : 100
    });
  }
};
if (!window.customElements.get("qr-code")) {
  window.customElements.define("qr-code", QrCode);
}

    </script>

  </body>
</html>

    {% schema %}
    {
      "name": "t:sections.gift_card.name",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.gift_card.settings.header_branding"
        },
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "t:sections.gift_card.settings.show_logo.label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "custom_logo",
          "label": "t:sections.gift_card.settings.custom_logo.label",
          "visible_if": "{{ section.settings.show_logo }}"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "t:sections.gift_card.settings.custom_image.label",
          "info": "t:sections.gift_card.settings.custom_image.info"
        },
        {
          "type": "header",
          "content": "t:sections.gift_card.settings.header_options"
        },
        {
          "type": "checkbox",
          "id": "show_qr_code",
          "label": "t:sections.gift_card.settings.show_qr_code.label",
          "default": true
        },
        {
          "type": "header",
          "content": "t:sections.gift_card.settings.header_layout"
        },
        {
          "type": "checkbox",
          "id": "show_layout",
          "label": "Show layout (header and footer)",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.gift_card.settings.header_style"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:sections.gift_card.settings.background_color.label",
          "default": "#ffffff"
        }
      ]
    }
    {% endschema %}